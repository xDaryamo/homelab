{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "flux": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Lavalink plugins in application.yml",
      "managerFilePatterns": ["/lavalink-application\\.yml$/"],
      "matchStrings": [
        "dependency: \"(?<depName>[^:\"]+:[^:\"]+):(?<currentValue>[^\"]+)\"\\s*\\n\\s*snapshot: (true|false)"
      ],
      "datasourceTemplate": "maven",
      "registryUrlTemplate": "https://maven.lavalink.dev/releases",
      "autoReplaceStringTemplate": "dependency: \"{{{depName}}}:{{{newValue}}}\"\n      snapshot: false"
    },
    {
      "customType": "regex",
      "description": "Image tags annotated with a renovate comment",
      "managerFilePatterns": ["/\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*tag: (?<currentValue>\\S+)"
      ]
    }
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "youtube-plugin breaks often: skip 1.18.2 and older, always review manually",
      "matchPackageNames": ["dev.lavalink.youtube:youtube-plugin"],
      "allowedVersions": "(1.18.2,)",
      "automerge": false,
      "labels": ["manual-review"]
    },
    {
      "description": "Auto-merge patch and minor updates",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Major updates always require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["breaking-change"]
    },
    {
      "description": "Cilium is the CNI — always review manually",
      "matchPackageNames": ["cilium"],
      "automerge": false,
      "labels": ["manual-review", "cilium"]
    },
    {
      "description": "Group all Flux controllers into one PR",
      "matchPackagePatterns": ["^ghcr.io/fluxcd/"],
      "groupName": "flux-controllers",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Staging files",
      "matchFileNames": ["**/staging/**"],
      "additionalBranchPrefix": "staging-",
      "labels": ["staging"]
    },
    {
      "description": "Production and base files",
      "matchFileNames": ["**/production/**", "**/base/**"],
      "additionalBranchPrefix": "prod-",
      "labels": ["production"]
    }
  ]
}
